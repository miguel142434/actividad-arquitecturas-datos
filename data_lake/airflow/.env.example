# Variables de entorno para el servicio de Airflow en EC2 (Copiar a .env)
# Estos valores son inyectados automáticamente por el user_data de Terraform,
# o pueden definirse manualmente:

DATALAKE_BUCKET=datalake-rss-eltiempo-dev-xxxx
AWS_DEFAULT_REGION=us-east-1
GLUE_DATABASE=rss_datalake_db
ATHENA_WORKGROUP=datalake-rss-eltiempo-workgroup
AIRFLOW_UID=50000
