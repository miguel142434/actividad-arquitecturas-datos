# Plantilla sin secretos. Completar cuando existan RDS y DocumentDB
# y se haya preparado conectividad privada en us-east-1.
# Las pruebas en memoria no usan este archivo.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=dwadmin
MYSQL_PASSWORD=
# Ruta al certificado CA oficial de RDS (PEM), descargado por separado.
MYSQL_SSL_CA=/opt/de-dw-aws/certs/global-bundle.pem

MONGO_DATABASE=ecommerce
# URI mongodb:// con usuario/contraseña codificados para URL, endpoint del clúster
# y authSource=admin. Mantener entre comillas simples al guardar en .env.
# Sustituir marcadores; no usar localhost ni un endpoint de instancia.
MONGODB_URI='mongodb://dwadmin:<PASSWORD_URL_ENCODED>@<DOCUMENTDB_CLUSTER_ENDPOINT>:27017/?authSource=admin'
# Ruta al certificado CA oficial de AWS para DocumentDB (PEM).
MONGO_TLS_CA_FILE=/opt/de-dw-aws/certs/global-bundle.pem

# Bucket privado creado por Terraform (output raw_bucket), región us-east-1.
S3_RAW_BUCKET=
# En EC2: autenticación S3 mediante su rol; no añadir claves AWS aquí.

# Redshift privado; outputs de Terraform, sin esquema en el host.
REDSHIFT_HOST=
REDSHIFT_DATABASE=ecommerce
REDSHIFT_USER=dwadmin
# dbt oculta variables DBT_ENV_SECRET_* en logs y artefactos.
DBT_ENV_SECRET_REDSHIFT_PASSWORD=
REDSHIFT_COPY_ROLE_ARN=
# Activar después de configurar QuickSight/SPICE y aprobar su permiso IAM de refresco.
QUICKSIGHT_ACCOUNT_ID=
QUICKSIGHT_DATASET_ID=
# Opcional: ruta absoluta al dbt de un entorno propio instalado en EC2.
# DBT_EXECUTABLE=/opt/de-dw-aws/.venv/bin/dbt

# Metadatos locales de Airflow, separados de las fuentes. configure_environment.sh
# genera solo los secretos vacíos; mantener POSTGRES_PASSWORD URL-safe (hex).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_UID=
AIRFLOW_UI_PORT=8080
